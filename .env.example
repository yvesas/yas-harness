# Copy to .env and adjust. Never commit .env.
# Loaded with `node --env-file=.env`; no dotenv dependency.

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Ports ------------------------------------------------------------------
# The project uses the 4000 block on the host, deliberately away from the
# default ports (5432, 3000, ...) so it can run next to other projects.
# Inside the container Postgres still listens on 5432.
POSTGRES_PORT=4000
HTTP_PORT=4001

# --- Database ---------------------------------------------------------------
# docker-compose reads POSTGRES_* to provision the container; the application
# reads DATABASE_URL. Keep the port consistent with POSTGRES_PORT above.
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness
POSTGRES_DB=harness
DATABASE_URL=postgres://harness:harness@localhost:4000/harness

# --- Console ----------------------------------------------------------------
# `docker compose up` publishes it on 127.0.0.1 only: it holds the master key,
# so reaching it from the network needs authentication this version lacks.
CONSOLE_PORT=4100
# The tenant it acts as. The `seed` service creates it; the console itself
# refuses to, because a console that mints what it should be showing you renders
# an empty dashboard that looks like a working one.
CONSOLE_TENANT_SLUG=console
# What `decided_by` records on an approval. There is no login, so without this
# it says the decision came through the console rather than inventing a name.
# CONSOLE_OPERATOR=

# --- Model providers --------------------------------------------------------
# Real keys go in .env only. The agent never reads these directly: the model
# gateway resolves them at call time.
#
# The harness names no vendor. config/models.json declares which providers
# exist, where they are, and which variable holds each key — so these names are
# the ones that file chose, not ones the code fixed. Rename them there and
# rename them here.
#
# The shipped config declares two, by the role they play rather than by who
# sells them:
#   premium — a strong model, for reasoning and anything sensitive
#   fast    — a cheap, quick one, for triage and simple work
# PREMIUM_MODEL_API_KEY=
# FAST_MODEL_API_KEY=
#
# Embeddings, for the shared knowledge (supermemory). The model must produce
# 1536 dimensions, which is what the schema stores.
# EMBEDDING_MODEL_API_KEY=
#
# NONE OF THE THREE ARE REQUIRED. Every one of them can instead be pasted on
# the console's Keys page, where it is encrypted at rest and never written to a
# file. Setting them here makes them the *deployment's* keys, used by any
# tenant that brought none of their own — which is convenient when you are the
# only tenant, and wrong when you are running this for other people.

# --- Credential encryption --------------------------------------------------
# Master key (KEK) for envelope encryption of connection credentials. It wraps
# a per-tenant data key; the data key encrypts that tenant's secrets. Required
# only for deployments that use external connections — without it, the vault is
# simply not built.
#
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Keep it outside the database and out of version control. Rotating it re-wraps
# the per-tenant keys, not every credential.
# MASTER_ENCRYPTION_KEY=

# --- Connector OAuth secrets ------------------------------------------------
# Each connector in config/connectors.json names its client secret's env var in
# clientSecretEnv. Set those here. See config/connectors.example.json.
# ATLASSIAN_CLIENT_SECRET=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET=

{
  "confluence": {
    "authorizationEndpoint": "https://auth.atlassian.com/authorize",
    "tokenEndpoint": "https://auth.atlassian.com/oauth/token",
    "clientId": "your-atlassian-client-id",
    "clientSecretEnv": "ATLASSIAN_CLIENT_SECRET",
    "scopes": ["read:confluence-content.all", "write:confluence-content", "offline_access"],
    "authorizationParams": { "audience": "api.atlassian.com", "prompt": "consent" }
  },

  "jira": {
    "authorizationEndpoint": "https://auth.atlassian.com/authorize",
    "tokenEndpoint": "https://auth.atlassian.com/oauth/token",
    "clientId": "your-atlassian-client-id",
    "clientSecretEnv": "ATLASSIAN_CLIENT_SECRET",
    "scopes": ["read:jira-work", "write:jira-work", "offline_access"],
    "authorizationParams": { "audience": "api.atlassian.com", "prompt": "consent" }
  },

  "github": {
    "authorizationEndpoint": "https://github.com/login/oauth/authorize",
    "tokenEndpoint": "https://github.com/login/oauth/access_token",
    "clientId": "your-github-client-id",
    "clientSecretEnv": "GITHUB_CLIENT_SECRET",
    "scopes": ["repo", "read:org"]
  },

  "google-drive": {
    "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenEndpoint": "https://oauth2.googleapis.com/token",
    "clientId": "your-google-client-id",
    "clientSecretEnv": "GOOGLE_CLIENT_SECRET",
    "scopes": ["https://www.googleapis.com/auth/drive.file"],
    "authorizationParams": { "access_type": "offline", "prompt": "consent" }
  },

  "slack": {
    "authorizationEndpoint": "https://slack.com/oauth/v2/authorize",
    "tokenEndpoint": "https://slack.com/api/oauth.v2.access",
    "clientId": "your-slack-client-id",
    "clientSecretEnv": "SLACK_CLIENT_SECRET",
    "scopes": ["channels:read", "channels:history", "chat:write", "search:read"]
  },

  "notion": {
    "authorizationEndpoint": "https://api.notion.com/v1/oauth/authorize",
    "tokenEndpoint": "https://api.notion.com/v1/oauth/token",
    "clientId": "your-notion-client-id",
    "clientSecretEnv": "NOTION_CLIENT_SECRET",
    "scopes": [],
    "authorizationParams": { "owner": "user" }
  },

  "google-calendar": {
    "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenEndpoint": "https://oauth2.googleapis.com/token",
    "clientId": "your-google-client-id",
    "clientSecretEnv": "GOOGLE_CLIENT_SECRET",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.readonly"
    ],
    "authorizationParams": { "access_type": "offline", "prompt": "consent" }
  },

  "calendly": {
    "authorizationEndpoint": "https://auth.calendly.com/oauth/authorize",
    "tokenEndpoint": "https://auth.calendly.com/oauth/token",
    "clientId": "your-calendly-client-id",
    "clientSecretEnv": "CALENDLY_CLIENT_SECRET",
    "scopes": []
  },

  "teams": {
    "authorizationEndpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
    "tokenEndpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
    "clientId": "your-azure-app-client-id",
    "clientSecretEnv": "MICROSOFT_CLIENT_SECRET",
    "scopes": [
      "https://graph.microsoft.com/Team.ReadBasic.All",
      "https://graph.microsoft.com/Channel.ReadBasic.All",
      "https://graph.microsoft.com/ChannelMessage.Read.All",
      "https://graph.microsoft.com/ChannelMessage.Send",
      "offline_access"
    ]
  }
}

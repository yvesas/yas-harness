# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
console/.next/
# Next regenerates this on every build, which strips the license header the
# check would otherwise want. It is generated output, so it is not committed.
console/next-env.d.ts

# test output
coverage/

# environment
.env
.env.*
!.env.example

# editors / OS
.DS_Store
.idea/
*.log

# local connector config (secrets referenced by env)
config/connectors.json
# Your model providers, models and routes. Shipped as models.example.json and
# copied on first start. Not versioned, for the same reason connectors.json is
# not: which vendor you use is yours to choose, and a file every fork inherits
# would make it ours. Nothing secret goes in it either way -- keys live on the
# console's Keys page or in the environment.
config/models.json

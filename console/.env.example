# The console reads the harness's database directly — it is not a client of an
# API, it is a product built on the library.
DATABASE_URL=postgres://yas:yas@127.0.0.1:4000/yas_harness

# Which tenant the console acts as. There is no login yet; one function
# (`currentTenant`) answers this, so adding authentication is one change.
CONSOLE_TENANT_SLUG=console

# Needed only once the console does anything with credentials (phase 1). It is
# never displayed and never written to a file — the console shows
# "defined / not defined" and nothing more.
# MASTER_ENCRYPTION_KEY=

{
  "name": "yas-harness",
  "version": "0.0.0",
  "description": "Reusable agent chassis (harness) for YAS Labs products",
  "license": "Apache-2.0",
  "author": "YAS Softwares LTDA",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "yas-harness-migrate": "./scripts/migrate.mjs"
  },
  "files": [
    "dist",
    "migrations",
    "config",
    "scripts/migrate.mjs",
    "scripts/ensure-tenant.mjs",
    "NOTICE"
  ],
  "workspaces": [
    "console"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run hooks && npm run build",
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "chat": "tsx --env-file-if-exists=.env examples/chat.ts",
    "start": "node dist/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/.bin/vitest run",
    "test:watch": "node --env-file-if-exists=.env node_modules/.bin/vitest",
    "test:coverage": "node --env-file-if-exists=.env node_modules/.bin/vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/check-license-headers.mjs",
    "license:fix": "node scripts/check-license-headers.mjs --fix",
    "check": "npm run lint && npm run format:check && npm run license:check && npm run boundaries && npm run isolation && npm run typecheck && npm run build && npm run test",
    "boundaries": "node scripts/check-boundaries.mjs",
    "hooks": "git config core.hooksPath .githooks || true",
    "package:check": "node scripts/check-package.mjs",
    "isolation": "node scripts/check-isolation.mjs",
    "console": "npm run dev --workspace console",
    "console:build": "npm run build --workspace console"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "gpt-tokenizer": "^3.4.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
